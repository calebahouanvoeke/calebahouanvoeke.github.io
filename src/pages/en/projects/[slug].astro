---
import Base from '../../../layouts/Base.astro';
import Case from '../../../components/Case.astro';
import { projects } from '../../../data/projects';
import { caseUrl } from '../../../lib/url';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<Base lang="en" title={project.en.title} description={project.en.tagline} alt={caseUrl('fr', project.slug)}>
  <Case lang="en" project={project} />
</Base>
