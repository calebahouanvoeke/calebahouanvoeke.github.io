---
// Page d'accueil : plan de transport des projets, puis sections détaillées
import { ui, profile, aiMethod, experience, education, skills, alsoBuilt, type Lang } from '../data/site';
import { projects } from '../data/projects';
import { u, caseUrl } from '../lib/url';
import TransitMap from './TransitMap.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const fr = lang === 'fr';
const pad = (n: number) => String(n).padStart(2, '0');

const tones = ['#ff5a24', '#1f3fbf', '#0f7a6c', '#d9a21b', '#7b2e1a', '#2f6b2a', '#4a3fd1', '#b0245a'];
const initials = (s: string) => s.replace(/[^A-Za-zÀ-ÿ ]/g, ' ').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<TransitMap lang={lang} />

<section id="work" class="sec wrap">
  <div class="sec-head reveal">
    <span class="eyebrow mono">01 · {t.nav.work}</span>
    <h2>{t.workTitle}</h2>
    <p>{t.workIntro}</p>
  </div>
  <ol class="index">
    {projects.map((p, i) => {
      const c = p[lang];
      return (
        <li class="reveal">
          <a href={caseUrl(lang, p.slug)} class="row" style={`--tone:${tones[i % tones.length]}`}>
            <span class="thumb" aria-hidden="true">{initials(c.title)}</span>
            <span class="what">
              <span class="name">{c.title}{p.confidential && <span class="mono stamp">{t.case.confidential}</span>}</span>
              <span class="tag muted">{c.tagline}</span>
            </span>
            <ul class="tags">{p.stack.slice(0, 3).map((s) => <li>{s}</li>)}</ul>
            <span class="mono meta muted">{c.status}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      );
    })}
  </ol>
  <div class="also reveal">
    <p class="eyebrow mono">{t.alsoTitle}</p>
    <ul>
      {alsoBuilt.map((a) => (
        <li><strong>{a.name}</strong><span class="mono muted">{a.stack}</span><span class="muted">{a.text[lang]}</span></li>
      ))}
    </ul>
  </div>
</section>

<section id="ai" class="sec wrap">
  <div class="sec-head reveal">
    <span class="eyebrow mono">02 · {t.nav.ai}</span>
    <h2>{t.aiTitle}</h2>
    <p>{t.aiIntro}</p>
  </div>
  <ol class="protocol">
    {aiMethod.map((m, i) => (
      <li class="reveal">
        <span class="step mono">{pad(i + 1)}</span>
        <h3>{m.title[lang]}</h3>
        <p>{m.text[lang]}</p>
        <p class="proof"><span class="mono">{t.proof}</span>{m.proof[lang]}</p>
      </li>
    ))}
  </ol>
</section>

<section id="path" class="sec wrap">
  <div class="sec-head reveal">
    <span class="eyebrow mono">03 · {t.nav.path}</span>
    <h2>{t.pathTitle}</h2>
  </div>
  <div class="path">
    <ol class="xp">
      {experience.map((x) => (
        <li class="reveal">
          <p class="mono muted">{x.period[lang]} · {x.place[lang]}</p>
          <h3>{x.role[lang]}</h3>
          <p class="org">{x.org}</p>
          <ul>{x.points.map((pt) => <li>{pt[lang]}</li>)}</ul>
        </li>
      ))}
    </ol>
    <ol class="edu reveal">
      {education.map((e) => (
        <li><p class="mono muted">{e.period}</p><p class="edu-t">{e.title[lang]}</p><p class="muted">{e.school}</p></li>
      ))}
    </ol>
  </div>

  <div id="skills" class="skills-block">
    <h3 class="skills-title reveal">{t.skillsTitle}</h3>
    <dl class="skills">
      {skills.map((s) => (<div class="reveal"><dt class="mono">{s.group[lang]}</dt><dd>{s.items}</dd></div>))}
    </dl>
  </div>
</section>

<section id="contact" class="sec wrap">
  <div class="contact reveal">
    <span class="eyebrow mono">04 · {t.nav.contact}</span>
    <h2>{t.contactTitle}</h2>
    <p>{t.contactIntro}</p>
    <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="links">
      <a class="pill accent" href={`mailto:${profile.email}`}>{fr ? 'Écrire un e-mail' : 'Send an email'}</a>
      <a class="pill" href={profile.linkedin}>LinkedIn ↗</a>
      <a class="pill" href={profile.github}>GitHub ↗</a>
      <a class="pill" href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a>
    </div>
  </div>
</section>

<style>
  /* Liste des projets */
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .index > li { border-bottom: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 56px minmax(0, 1.6fr) minmax(0, 1fr) 150px 36px; gap: 22px; align-items: center; padding: 20px 0; text-decoration: none; }
  .thumb { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 600; font-size: 17px;
    background: radial-gradient(circle at 32% 28%, color-mix(in srgb, var(--tone) 55%, #fff), var(--tone) 60%); transition: transform .3s; }
  .what { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-weight: 500; font-size: clamp(20px, 2.2vw, 26px); letter-spacing: -.02em; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .stamp { font-size: 10px; padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .tag { font-size: 15px; }
  .meta { font-size: 11px; }
  .arrow { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; transition: background .25s, color .25s, border-color .25s; }
  .row:hover .thumb { transform: scale(1.08); }
  .row:hover .arrow { background: var(--accent); border-color: var(--accent); color: #fff; }

  .also { margin-top: 40px; }
  .also ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .also li { display: flex; flex-direction: column; gap: 4px; padding: 20px; border-radius: 20px; background: var(--bg-2); font-size: 15px; }

  /* Méthode IA */
  .protocol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .protocol li { display: flex; flex-direction: column; padding: 24px; border-radius: 24px; background: var(--bg-2); }
  .step { width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-size: 11px; }
  .protocol h3 { font-weight: 600; font-size: 20px; line-height: 1.2; letter-spacing: -.02em; margin: 18px 0 8px; }
  .protocol p { font-size: 15px; color: var(--muted); margin: 0 0 18px; }
  .proof { margin-top: auto !important; padding: 14px; border-radius: 14px; background: #fff; color: var(--ink) !important; }
  .proof .mono { display: block; color: var(--accent); font-size: 10px; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 4px; }

  /* Parcours et compétences */
  .path { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: clamp(28px, 5vw, 64px); }
  .xp, .edu { list-style: none; padding: 0; margin: 0; }
  .xp > li { padding-bottom: 28px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
  .xp p { margin: 0; }
  .xp h3 { font-weight: 600; font-size: 22px; letter-spacing: -.02em; margin: 6px 0 2px; }
  .org { color: var(--accent); }
  .xp ul { margin: 10px 0 0; padding-left: 18px; color: var(--muted); }
  .edu li { padding: 22px; margin-bottom: 12px; border-radius: 20px; background: var(--bg-2); }
  .edu p { margin: 0; }
  .edu-t { font-weight: 500; margin: 4px 0 2px !important; }
  .skills-block { margin-top: clamp(48px, 7vw, 80px); }
  .skills-title { font-weight: 600; font-size: 22px; letter-spacing: -.02em; margin: 0 0 16px; }
  .skills { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 0 40px; }
  .skills div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .skills dt { color: var(--accent); }
  .skills dd { margin: 0; font-size: 15px; }

  /* Contact : grand panneau noir, écho du disque central */
  .contact { background: var(--disc); color: #fff; border-radius: clamp(24px, 4vw, 48px); padding: clamp(32px, 6vw, 80px); display: flex; flex-direction: column; gap: 16px; }
  .contact .eyebrow { color: #a9a8a3; }
  .contact h2 { margin: 0; font-weight: 500; font-size: clamp(34px, 5.2vw, 64px); line-height: 1.02; letter-spacing: -.035em; }
  .contact p { margin: 0; color: #c9c8c3; max-width: 560px; }
  .mail { font-weight: 500; font-size: clamp(20px, 3.4vw, 40px); letter-spacing: -.02em; text-decoration: none; overflow-wrap: anywhere; margin-top: 12px; }
  .mail:hover { color: var(--accent); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .contact .pill:not(.accent) { border-color: #3a3a3e; }
  .contact .pill:not(.accent):hover { border-color: #fff; }

  /* Tablette : la liste des projets se resserre */
  @media (max-width: 1000px) {
    .row { grid-template-columns: 48px minmax(0, 1fr) 36px; gap: 16px; }
    .thumb { width: 48px; height: 48px; font-size: 15px; }
    .row .tags, .row .meta { display: none; }
  }

  @media (max-width: 820px) {
    .skills div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
