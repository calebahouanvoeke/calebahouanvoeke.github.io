---
// Accueil : le portfolio dessiné comme un plan de transport (clin d'œil à Mu-CAR).
// Une ligne par domaine, une station par projet, une correspondance quand un projet couvre deux domaines.
// Pour placer un nouveau projet sur la carte, ajouter son slug dans "stations" ci-dessous.
// Sans coordonnées, il apparaît quand même dans la liste mobile et dans la section Projets.
import { ui, profile, type Lang } from '../data/site';
import { projects } from '../data/projects';
import { u, caseUrl } from '../lib/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const fr = lang === 'fr';

const lines = [
  { id: 'web', name: 'Web', color: '#ff5a24', d: 'M100,150 H140 L300,310 H500 L660,150 H760' },
  { id: 'ai', name: fr ? 'IA' : 'AI', color: '#1f3fbf', d: 'M120,330 H1080' },
  { id: 'mobile', name: 'Mobile', color: '#0f8a6c', d: 'M440,540 H570 L760,350 H820' },
  { id: 'game', name: fr ? 'Jeu & VR' : 'Games & VR', color: '#8a3ad6', d: 'M1140,540 H960 V350' },
];
const colorOf = Object.fromEntries(lines.map((l) => [l.id, l.color]));

// x, y : centre de la station ; inter : correspondance verticale ; lx, ly, a : étiquette
const stations: Record<string, { x: number; y: number; inter?: boolean; lx: number; ly: number; a?: string }> = {
  'eah-bien-etre': { x: 100, y: 150, lx: 86, ly: 116, a: 'start' },
  castly: { x: 300, y: 320, inter: true, lx: 300, ly: 386 },
  'mu-car': { x: 500, y: 320, inter: true, lx: 500, ly: 386 },
  jarvis: { x: 760, y: 340, inter: true, lx: 760, ly: 296 },
  beninlifestyle: { x: 960, y: 340, inter: true, lx: 960, ly: 296 },
  'radio-amitie': { x: 480, y: 540, lx: 480, ly: 584 },
  'au-dela-du-cadre': { x: 1050, y: 540, lx: 1050, ly: 584 },
  priority: { x: 1140, y: 540, lx: 1140, ly: 512 },
};
const team = fr ? 'Votre équipe ?' : 'Your team?';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="hero">
  <div class="wrap hero-top">
    <div>
      <p class="eyebrow mono reveal">{t.kicker}</p>
      <h1 class="reveal">Caleb<br />Ahouanvoeke</h1>
    </div>
    <div class="hero-side reveal">
      <p class="lead">{t.hero}</p>
      <p class="status"><span class="live-dot" aria-hidden="true"></span>{t.status}</p>
      <div class="cta">
        <a class="pill light" href={u(profile.cv[lang])} download>{t.cvBtn} ↓</a>
        <a class="pill" href="#work">{t.workBtn}</a>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="map-card reveal" data-map>
      <div class="map-head">
        <p class="mono muted">{fr ? `Plan du réseau · ${projects.length} stations` : `Network map · ${projects.length} stations`}</p>
        <div class="legend" role="group" aria-label={fr ? 'Filtrer par ligne' : 'Filter by line'}>
          {lines.map((l) => (
            <button class="line-btn" data-line={l.id} aria-pressed="false" style={`--c:${l.color}`}>
              <span class="sw" aria-hidden="true"></span>{l.name}
            </button>
          ))}
        </div>
      </div>

      <div class="map" data-map-box>
        <svg viewBox="0 0 1200 620" role="img" aria-label={fr ? 'Plan des projets de Caleb' : 'Map of Caleb’s projects'}>
          <g class="grid" aria-hidden="true">
            {Array.from({ length: 13 }, (_, i) => <line x1={i * 100} y1="0" x2={i * 100} y2="620" />)}
            {Array.from({ length: 7 }, (_, i) => <line x1="0" y1={i * 100} x2="1200" y2={i * 100} />)}
          </g>
          {lines.map((l) => (
            <path class="track" data-line={l.id} d={l.d} stroke={l.color} pathLength="1" />
          ))}
          <path class="track-next" d="M760,150 H860" stroke={colorOf.web} />
          <circle r="7" class="train" fill="#fff" stroke={colorOf.web} stroke-width="4">
            <animateMotion dur="11s" repeatCount="indefinite" path="M100,150 H140 L300,310 H500 L660,150 H860" />
          </circle>

          <a href="#contact" class="station team" data-lines="web" data-label={fr ? 'Prochain arrêt' : 'Next stop'} data-title={team} data-sub={fr ? 'Une alternance dans votre équipe. Parlons-en.' : 'A work-study role in your team. Let’s talk.'}>
            <circle cx="860" cy="150" r="13" class="dot open" />
            <text x="860" y="116" text-anchor="middle" class="lbl strong">{team}</text>
          </a>

          {projects.map((p, i) => {
            const s = stations[p.slug];
            if (!s) return null;
            const c = p[lang];
            return (
              <a href={caseUrl(lang, p.slug)} class="station" data-lines={p.domains.join(' ')}
                 data-label={`N° ${pad(i + 1)} · ${c.status}`} data-title={c.title} data-sub={c.tagline} data-x={s.x} data-y={s.y}>
                {s.inter
                  ? <rect x={s.x - 13} y={s.y - 29} width="26" height="58" rx="13" class="dot" />
                  : <circle cx={s.x} cy={s.y} r="12" class="dot" />}
                <text x={s.lx} y={s.ly} text-anchor={s.a ?? 'middle'} class="lbl">{c.title}</text>
                {p.live && <circle cx={s.x + 20} cy={s.y - (s.inter ? 26 : 16)} r="5" class="live" />}
              </a>
            );
          })}
        </svg>

        <div class="card" data-card aria-hidden="true">
          <span class="mono card-label" data-card-label></span>
          <strong data-card-title></strong>
          <span class="card-sub" data-card-sub></span>
          <span class="mono card-go">{fr ? 'Ouvrir ↗' : 'Open ↗'}</span>
        </div>
      </div>

      <ol class="route">
        {projects.map((p, i) => {
          const c = p[lang];
          return (
            <li data-lines={p.domains.join(' ')} style={`--c:${colorOf[p.domains[0]]}`}>
              <a href={caseUrl(lang, p.slug)}>
                <span class="stop" aria-hidden="true"></span>
                <span class="info">
                  <span class="mono muted">N° {pad(i + 1)} · {c.status}</span>
                  <strong>{c.title}</strong>
                  <span class="muted">{c.tagline}</span>
                  <span class="chips">{p.domains.map((d) => <span style={`--c:${colorOf[d]}`}>{lines.find((l) => l.id === d)?.name}</span>)}</span>
                </span>
              </a>
            </li>
          );
        })}
        <li data-lines="web" class="end" style={`--c:${colorOf.web}`}>
          <a href="#contact"><span class="stop" aria-hidden="true"></span><span class="info"><span class="mono muted">{fr ? 'Prochain arrêt' : 'Next stop'}</span><strong>{team}</strong></span></a>
        </li>
      </ol>

      <p class="mono muted hint">{fr ? 'Survolez une station pour la découvrir, cliquez pour ouvrir l’étude de cas.' : 'Hover a station to preview it, click to open the case study.'}</p>
    </div>
  </div>
</section>

<script>
  const map = document.querySelector<HTMLElement>('[data-map]');
  if (map) {
    // Fiche flottante au survol d'une station
    const box = map.querySelector<HTMLElement>('[data-map-box]')!;
    const card = map.querySelector<HTMLElement>('[data-card]')!;
    const set = (sel: string, v = '') => (card.querySelector<HTMLElement>(sel)!.textContent = v);
    map.querySelectorAll<SVGAElement>('.station').forEach((st) => {
      const show = () => {
        const d = st.dataset;
        set('[data-card-label]', d.label); set('[data-card-title]', d.title); set('[data-card-sub]', d.sub);
        const dot = st.querySelector('.dot')!.getBoundingClientRect();
        const b = box.getBoundingClientRect();
        const x = dot.left + dot.width / 2 - b.left;
        const above = dot.top - b.top > b.height * 0.45;
        card.style.left = `${Math.min(Math.max(x, 140), b.width - 140)}px`;
        card.style.top = above ? `${dot.top - b.top - 14}px` : `${dot.bottom - b.top + 14}px`;
        card.classList.toggle('above', above);
        card.classList.add('on');
      };
      const hide = () => card.classList.remove('on');
      st.addEventListener('mouseenter', show); st.addEventListener('focus', show);
      st.addEventListener('mouseleave', hide); st.addEventListener('blur', hide);
    });

    // Légende : mettre une ligne en avant (un second clic revient à tout afficher)
    const btns = map.querySelectorAll<HTMLButtonElement>('[data-line]');
    let current = '';
    btns.forEach((b) => {
      if (b.tagName !== 'BUTTON') return;
      b.addEventListener('click', () => {
        current = current === b.dataset.line ? '' : b.dataset.line!;
        map.classList.toggle('filtered', !!current);
        map.querySelectorAll<HTMLButtonElement>('button[data-line]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.line === current)));
        map.querySelectorAll<Element>('.track[data-line]').forEach((p) => p.classList.toggle('hl', p.getAttribute('data-line') === current));
        map.querySelectorAll<HTMLElement>('[data-lines]').forEach((el) => {
          el.classList.toggle('hl', !!current && (el.dataset.lines ?? '').split(' ').includes(current));
        });
      });
    });

    // Pas de train animé si l'utilisateur limite les animations
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) map.querySelector('.train')?.remove();
  }
</script>

<style>
  .hero { padding-top: clamp(36px, 6vw, 72px); }
  .hero-top { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: end; }
  h1 { margin: 18px 0 0; font-weight: 600; font-size: clamp(50px, 6.6vw, 100px); line-height: .92; letter-spacing: -.055em; }
  .lead { margin: 0; font-size: clamp(19px, 1.9vw, 23px); line-height: 1.4; letter-spacing: -.01em; }
  .status { margin: 18px 0 0; display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #1f9d55; box-shadow: 0 0 0 4px #1f9d5522; flex: none; }
  .cta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }

  .map-card { margin-top: clamp(36px, 6vw, 64px); background: var(--bg-2); border-radius: clamp(22px, 3vw, 36px); padding: clamp(18px, 2.6vw, 32px); }
  .map-head { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; }
  .map-head p { margin: 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px; }
  .line-btn { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 13px; font-weight: 500; transition: border-color .2s, background .2s, color .2s; }
  .line-btn .sw { width: 16px; height: 4px; border-radius: 2px; background: var(--c); }
  .line-btn:hover { border-color: var(--c); }
  .line-btn[aria-pressed='true'] { background: var(--c); border-color: var(--c); color: #fff; }
  .line-btn[aria-pressed='true'] .sw { background: #fff; }

  .map { position: relative; margin-top: 14px; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid line { stroke: #e9e8e3; stroke-width: 1; }
  .track { fill: none; stroke-width: 10; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s cubic-bezier(.6, 0, .2, 1) forwards; transition: opacity .3s; }
  .track:nth-of-type(2) { animation-delay: .25s; } .track:nth-of-type(3) { animation-delay: .5s; } .track:nth-of-type(4) { animation-delay: .75s; }
  .track-next { fill: none; stroke-width: 10; stroke-linecap: round; stroke-dasharray: 2 18; opacity: .55; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .track { stroke-dashoffset: 0; animation: none; } }

  .station { cursor: pointer; transition: opacity .3s; }
  .station:focus { outline: none; }
  .dot { fill: #fff; stroke: var(--ink); stroke-width: 4; transition: fill .2s; }
  .dot.open { stroke-dasharray: 4 4; }
  .station:hover .dot, .station:focus-visible .dot { fill: var(--ink); }
  .lbl { font: 500 19px var(--sans); fill: var(--ink); letter-spacing: -.01em; paint-order: stroke; stroke: var(--bg-2); stroke-width: 6px; stroke-linejoin: round; }
  .lbl.strong { font-weight: 700; fill: var(--accent); }
  .live { fill: #1f9d55; stroke: var(--bg-2); stroke-width: 3; }
  .filtered .track:not(.hl), .filtered .track-next { opacity: .12; }
  .filtered .station:not(.hl), .filtered .route li:not(.hl) { opacity: .2; }

  .card { position: absolute; z-index: 3; width: 280px; transform: translate(-50%, 0) scale(.96); opacity: 0; pointer-events: none;
    background: var(--ink); color: #fff; border-radius: 20px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; transition: opacity .2s, transform .2s;
    box-shadow: 0 18px 40px -18px rgba(14, 14, 16, .5); }
  .card.above { transform: translate(-50%, -100%) scale(.96); }
  .card.on { opacity: 1; transform: translate(-50%, 0) scale(1); }
  .card.above.on { transform: translate(-50%, -100%) scale(1); }
  .card strong { font-size: 20px; font-weight: 600; letter-spacing: -.02em; }
  .card-label { color: #a9a8a3; font-size: 11px; }
  .card-sub { font-size: 14px; color: #d4d3ce; line-height: 1.4; }
  .card-go { color: var(--accent); margin-top: 6px; font-size: 11px; }

  .route { display: none; }
  .hint { margin: 10px 0 0; text-align: right; font-size: 11px; }

  /* Mobile et petites tablettes : la carte devient une ligne verticale lisible */
  @media (max-width: 820px) {
    .hero-top { grid-template-columns: 1fr; align-items: start; }
    .map, .hint { display: none; }
    .map-head { flex-direction: column; align-items: flex-start; }
    .legend { flex-wrap: nowrap; overflow-x: auto; max-width: 100%; scrollbar-width: none; }
    .line-btn { flex: none; }
    .route { display: block; list-style: none; margin: 22px 0 0; padding: 0; }
    .route li { position: relative; transition: opacity .3s; }
    .route li::before { content: ''; position: absolute; left: 11px; top: 0; bottom: 0; width: 6px; background: var(--c); }
    .route li:first-child::before { top: 18px; }
    .route li.end::before { bottom: auto; height: 18px; background: repeating-linear-gradient(var(--c) 0 4px, transparent 4px 9px); }
    .route a { display: flex; gap: 16px; padding: 10px 0 18px; text-decoration: none; }
    .stop { position: relative; z-index: 1; flex: none; width: 28px; height: 28px; border-radius: 50%; background: #fff; border: 4px solid var(--ink); margin-top: 2px; }
    .route .end .stop { border-style: dashed; }
    .info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .info strong { font-size: 20px; font-weight: 600; letter-spacing: -.02em; }
    .info > .muted:not(.mono) { font-size: 15px; }
    .chips { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .chips span { font: 11px var(--mono); padding: 3px 9px; border-radius: 999px; color: #fff; background: var(--c); }
  }
</style>
